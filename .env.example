# ── AI providers ─────────────────────────────────────────────────────
# OpenRouter is the only required key. It serves BOTH steps of the
# research pipeline: the web-search step (a ":online" model variant) and
# the generation step.
#
# Cold research call: ~$0.005. A cache hit costs nothing.
OPENROUTER_API_KEY=

# Optional. Second choice for the generation step only. Search always
# goes through OpenRouter. Without this the app still works — it just
# has one fewer fallback.
NVIDIA_NIM_API_KEY=

# ── App ─────────────────────────────────────────────────────────────
FLASK_ENV=development
SECRET_KEY=change-me-in-production
